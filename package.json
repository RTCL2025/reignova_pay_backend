{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "Reusable multi-tenant payment microservice with Pawapay integration",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev:nodemon": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "node scripts/db-reset.cjs",
    "migration:create": "sequelize-cli migration:create --name",
    "seed:create": "sequelize-cli seed:create --name",
    "generate:postman": "tsx src/scripts/generate-postman.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "keywords": [
    "payment",
    "microservice",
    "pawapay",
    "mobile-money",
    "orchestration",
    "multi-tenant"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.20",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^6.28.1",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.21.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
