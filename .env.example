# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Admin API Key (used for application registration & key management)
ADMIN_API_KEY=admin_secret_super_secure_key_change_in_production

# Pepper used when hashing client application API keys with SHA-256
API_KEY_PEPPER=change_this_to_a_long_random_secret_pepper_in_production

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment_service
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# Pawapay Integration
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.cloud
PAWAPAY_API_TOKEN=sandbox_pawapay_token_replace_me
PAWAPAY_REQUEST_TIMEOUT_MS=15000
PAWAPAY_CONNECT_TIMEOUT_MS=5000
PAWAPAY_AUTO_PREDICT_PROVIDER=true
PAWAPAY_VERIFY_CALLBACK_SIGNATURES=false

# Notification System
NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_POLL_INTERVAL_MS=30000

# Security & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_AUTH_MAX=600
RATE_LIMIT_WEBHOOK_MAX=300
