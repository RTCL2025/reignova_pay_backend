# Dependencies
node_modules/

# Production output
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
# Ignore every .env variant — including backups such as .env.bak-presupabase —
# so a stray copy of real credentials can never be committed. .env.example is
# the one file that must stay tracked.
.env*
!.env.example

# Testing & Coverage
coverage/
.nyc_output/

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.superpowers

# Temporary / Scratch
tmp/
temp/
